---
// Shared page shell: <head>, header, footer, icon sprite and site-wide scripts.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  current?: 'product' | 'aboutus' | 'contact';
  icons?: string[];
}

const { title, description, current, icons = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap">
  <!-- Lets CSS hide the fade-up blocks only when JavaScript runs -->
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <IconSprite names={icons} />
  <Header current={current} />
  <main>
    <slot />
  </main>
  <Footer current={current} />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
