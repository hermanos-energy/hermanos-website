---
import Layout from '../layouts/Layout.astro';
import GetInTouch from '../components/GetInTouch.astro';
import Photo from '../components/Photo.astro';
import { url, srcset } from '../lib/url';
import '../styles/home.css';

const img = (name: string) => `images/home/images/${name}`;
const news = (name: string) => `images/home/news/${name}`;

const visionCards = [
  { icon: 'icon-heat.svg', text: 'Using your summer sun to heat in the winter, with power to heat.' },
  { icon: 'icon-power.svg', text: 'All year round green electricity with power to power.' },
  { icon: 'icon-drive.svg', text: 'Driving a vehicle on hydrogen. With power to drive.' },
];

const emsPoints = [
  'Makes predictions based on your historical data, and the weather',
  'Live connected to your solar panels and consumption.',
  'Can scale up and down in milliseconds',
  'Picks the right moments based on day ahead prices',
];
---

<Layout
  title="Hermanos Energy"
  description="Hermanos Energy is dedicated to providing cutting-edge solutions for energy storage using hydrogen technology. As the world's energy demands continue to grow, it's crucial that we find sustainable and reliable ways to power our lives."
  icons={['check', 'arrow-right']}>

  <!-- ── Hero ── -->
  <section class="home-hero">
    <Photo class="home-hero__background" src="home/hero.png" alt="" sizes="100vw" eager />
    <div class="home-hero__text">
      <h1 class="page-title">Endless clean energy.</h1>
      <p class="page-subtitle">We are dedicated to providing cutting-edge solutions for energy storage using hydrogen technology.</p>
      <a class="button button--white button--large button--shadow" href={url('contact')} target="_blank">Contact us</a>
    </div>
  </section>

  <!-- ── Looking to the future ── -->
  <section class="section section--white future">
    <div class="split">
      <div class="split__text reveal">
        <h2 class="title">Looking to the future.</h2>
        <p class="body-text">Renewable energy sources like wind power, and solar are increasing rapidly but to balance the energy grid and secure a stable power supply, the world is still counting on fossil fuel as an energy source. A year-round stable power supply without fossil fuels can only be achieved with local energy storage.</p>
      </div>
      <div class="split__photo reveal">
        <Photo src="home/future.jpg" sizes="(min-width: 1200px) 552px, 100vw" alt="Hermanos Energy installation next to a farm building with solar panels" />
      </div>
    </div>
  </section>

  <!-- ── Energy transition ── -->
  <section class="section section--purple transition">
    <div class="split">
      <div class="charts reveal">
        <div class="charts__chart">
          <img src={url(img('chart-prices-1024.png'))} srcset={srcset(img('chart-prices'), [[1024, '-1024.png'], [2048, '-2048.png']])} sizes="(min-width: 1200px) 552px, 100vw" alt="Bar chart: typical electricity prices over a day, lowest around midday">
        </div>
        <div class="charts__chart">
          <img src={url(img('chart-solar-wind-1024.png'))} srcset={srcset(img('chart-solar-wind'), [[1024, '-1024.png'], [2048, '-2048.png']])} sizes="(min-width: 1200px) 552px, 100vw" alt="Bar chart: solar and wind electricity on the grid over a day, highest around midday">
        </div>
      </div>
      <div class="split__text reveal">
        <h2 class="title">You can help and benefit from the energy transition.</h2>
        <p class="body-text">On windy and sunny periods during the day the green energy supply exceeds the demand which is leading to very low prices, and sometimes even free electricity. Green energy is cheap energy! With the energy storage of Hermanos Energy you can benefit from the daily and seasonal price difference and contribute to net zero at the same time.</p>
      </div>
    </div>
  </section>

  <!-- ── One vision, three products ── -->
  <section class="section vision">
    <div class="vision__inner">
      <div class="vision__header reveal">
        <h2 class="title vision__title">One vision. Three products.</h2>
        <p class="body-text vision__text">It is our mission to use the abundance of green energy to replace fossil fuels wherever they are used. We always produce the hydrogen locally, at your home or business, and it can be used in various ways.</p>
      </div>
      <div class="vision__cards">
        {visionCards.map((card) => (
          <div class="vision-card">
            <img src={url(img(card.icon))} alt="" width="115" height="79">
            <h3>{card.text}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── News slider ── -->
  <section class="news" aria-label="News">
    <div class="slider" data-interval="8000" tabindex="0" aria-roledescription="carousel">
      <div class="slider__track">

        <article class="slider__slide news-slide">
          <div class="news-slide__text">
            <div class="news-slide__head" style="--head-width: 516px">
              <p class="label">NEWS</p>
              <h3 class="title">We attended Vakbeurs Energie</h3>
              <p class="body-text">7/8/9 Oktober Brabanthallen</p>
            </div>
            <p class="body-text">We had a great time at Vakbeurs Energie, where we gave daily talks on becoming self-sufficient with hydrogen storage. We also discussed the business case for long-term storage and how it differs from battery storage. Thank you to everyone who joined our sessions! If you missed us, you can still learn more about our solutions by contacting us directly.</p>
            <div class="news-slide__logos">
              <img src={url(news('logo-vakbeurs.png'))} alt="Vakbeurs Energie" width="201" height="48">
            </div>
          </div>
          <div class="news-slide__media">
            <div class="news-slide__image reveal">
              <Photo src="home/news/vakbeurs.jpg" sizes="(min-width: 1200px) 1000px, 100vw" alt="Hermanos Energy giving a talk at Vakbeurs Energie" />
            </div>
          </div>
        </article>

        <article class="slider__slide news-slide">
          <div class="news-slide__text">
            <div class="news-slide__head">
              <p class="label">NEWS</p>
              <h3 class="title">Tank hydrogen at SAIL Amsterdam</h3>
              <p class="body-text">Powered by Hermanos Energy and XNRG.tech</p>
            </div>
            <p class="body-text">SAIL Amsterdam is one of the biggest maritime events in the world, with more than 10.000 boats, and 2.3 million visitors a day. We are proud to power their fleet of hydrogen boats. XNRG.tech developed a series of hydrogen driven boats for the event which can transport up to 50 people. And while they are out for the day we produce hydrogen, so that they can refuel for the next day when they come back. News channel AT5 made a short video about our installation.</p>
            <div class="news-slide__logos">
              <img src={url(news('logo-hermanos.png'))} alt="Hermanos Energy" width="181" height="48">
              <img src={url(news('logo-sail.svg'))} alt="SAIL Amsterdam" width="201" height="48">
              <img src={url(news('logo-xnrg.png'))} alt="XNRG.tech" width="202" height="48">
            </div>
          </div>
          <div class="news-slide__media">
            <!-- Click-to-play: the YouTube player (3+ MB) only loads when a visitor starts the video -->
            <button class="video-facade news-slide__video" type="button" data-youtube="BQmDOf-xGaQ" data-title="AT5 about Hermanos Energy at SAIL Amsterdam" aria-label="Play video: AT5 about Hermanos Energy at SAIL Amsterdam">
              <Photo src="home/news/sail-video-thumbnail.jpg" alt="" sizes="(min-width: 810px) 768px, 406px" />
              <span class="video-facade__play" aria-hidden="true"></span>
            </button>
            <a class="small-link" href="https://www.sail.nl/nieuws/een-primeur-tijdens-sail-sloep-aftanken-met-waterstof">More about Hermanos Energy at sail <svg aria-hidden="true"><use href="#icon-arrow-right" /></svg></a>
          </div>
        </article>

        <article class="slider__slide news-slide">
          <div class="news-slide__text">
            <div class="news-slide__head">
              <p class="label">NEWS</p>
              <h3 class="title">Erik Blaauw pioneers with hydrogen system</h3>
              <p class="body-text">First green hydrogen production in Flevoland</p>
            </div>
            <p class="body-text">Our customer Erik Blaauw from Lelystad is the first to produce green hydrogen in the province of Flevoland. The NOS, omroep flevoland and Waterstof Magazine wrote about the opening event, watch the video from omroep flevoland below or visit the NOS website to read their article.</p>
            <div class="news-slide__logos">
              <img src={url(news('logo-nos.png'))} alt="NOS" width="181" height="48">
              <img class="news-slide__logo--cover" src={url(news('logo-omroep-flevoland.png'))} alt="Omroep Flevoland" width="201" height="48">
              <img src={url(news('logo-waterstof-magazine.png'))} alt="Waterstof Magazine" width="202" height="48">
            </div>
          </div>
          <div class="news-slide__media">
            <video class="news-slide__video" width="706" height="430" controls muted playsinline preload="metadata">
              <source src="https://d5ms27yy6exnf.cloudfront.net/video/middel/250613_WWW_Waterstof_00001HYI.mp4" type="video/mp4">
            </video>
            <a class="small-link" href="https://nos.nl/regio/flevoland/artikel/644485">read nos article <svg aria-hidden="true"><use href="#icon-arrow-right" /></svg></a>
          </div>
        </article>

        <article class="slider__slide news-slide">
          <div class="news-slide__text">
            <div class="news-slide__head">
              <p class="label">NEWS</p>
              <h3 class="title">Power2You gets grant</h3>
              <p class="body-text">Co-financed by the European Union</p>
            </div>
            <p class="body-text">We are proud to announce that we have been awarded a European grant through the EFRO programme <em>Kansen voor West III for our innovation program Power2You</em>. This contribution enables us as a company to grow and ensures that we can continue to invest time and energy into technical innovation over the next two years. It is also a valuable recognition of the social impact we are making.</p>
            <div class="news-slide__logos">
              <img src={url(news('logo-kansen-voor-west.png'))} alt="Kansen voor West" width="212" height="48">
              <img src={url(news('logo-eu.png'))} alt="Co-funded by the European Union" width="247" height="48">
            </div>
          </div>
          <div class="news-slide__media">
            <div class="news-slide__image news-slide__image--tall reveal">
              <Photo src="home/news/power2you.png" sizes="(min-width: 1200px) 1000px, 100vw" alt="Power2You" />
            </div>
          </div>
        </article>

        <article class="slider__slide news-slide">
          <div class="news-slide__text">
            <div class="news-slide__head" style="--head-width: 516px">
              <p class="label">NEWS</p>
              <h3 class="title">Hydrogen Innovation Award 2024</h3>
              <p class="body-text">Presented by TKI Nieuw Gas</p>
            </div>
            <p class="body-text">Hermanos Energy has been recognised for an innovative hydrogen solution designed for local energy storage, catering to homes, farmers, and small businesses. Through the use of smart software and decentralised storage, the system ensures flexibility and affordable hydrogen prices.</p>
            <div class="news-slide__logos">
              <img src={url(news('logo-nationale-energieweek.png'))} alt="Nationale Energieweek" width="181" height="48">
              <img src={url(news('logo-vakbeurs.png'))} alt="Vakbeurs Energie" width="201" height="48">
              <img src={url(news('logo-zero-emission.png'))} alt="Zero Emission Ecomobiel" width="202" height="48">
              <img src={url(news('logo-industrial-heat-power.png'))} alt="Industrial Heat+Power" width="175" height="48">
            </div>
          </div>
          <div class="news-slide__media">
            <div class="news-slide__image reveal">
              <Photo src="home/news/award.jpg" sizes="(min-width: 1200px) 1000px, 100vw" alt="Hermanos Energy receiving the Hydrogen Innovation Award 2024" />
            </div>
            <a class="small-link" href="https://www.linkedin.com/feed/update/urn:li:activity:7252244767223214080/">Watch interview <svg aria-hidden="true"><use href="#icon-arrow-right" /></svg></a>
          </div>
        </article>

      </div>

      <button class="slider__button slider__button--prev" type="button" aria-label="Previous news item">◀</button>
      <button class="slider__button slider__button--next" type="button" aria-label="Next news item">▶</button>
      <div class="slider__dots"></div>
    </div>
  </section>

  <!-- ── Our own EMS ── -->
  <section class="section ems">
    <div class="ems__inner">
      <div class="ems__text reveal">
        <div class="ems__intro">
          <p class="label">Our OWN EMS</p>
          <h2 class="heading">The software behind it all.</h2>
          <p class="body-text">Green energy is all about timing, we make hydrogen when there is an abundance of green cheap electricity, and use it when you need it most, our software takes care of that.</p>
        </div>
        <ul class="ems__list">
          {emsPoints.map((point) => <li><svg><use href="#icon-check" /></svg>{point}</li>)}
        </ul>
      </div>
      <div class="ems__image reveal">
        <Photo src="home/ems.jpg" sizes="(min-width: 1200px) 575px, 100vw" alt="The Hermanos Energy dashboard on a laptop and tablet" />
      </div>
    </div>
  </section>

  <GetInTouch image="home/contact.jpg" alt="Hermanos Energy hydrogen refuelling station" stackedTablet />
</Layout>
