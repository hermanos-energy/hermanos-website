---
// Shown by GitHub Pages for any address that doesn't exist.
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import '../styles/not-found.css';
---

<Layout title="Page not found — Hermanos Energy" description="This page doesn't exist. Go back to the Hermanos Energy homepage.">
  <section class="not-found">
    <p class="label">404</p>
    <h1 class="page-title">Page not found.</h1>
    <p class="page-subtitle">The page you are looking for doesn't exist or has moved.</p>
    <a class="button button--white button--shadow" href={url()}>Back to the homepage</a>
  </section>
</Layout>
