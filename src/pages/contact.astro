---
import Layout from '../layouts/Layout.astro';
import '../styles/contact.css';
---

<Layout
  title="Contact — Hermanos Energy"
  description="Get in touch with Hermanos Energy for a demo or a detailed calculation of which hardware solution fits your energy setup."
  current="contact"
  icons={['map-pin', 'linkedin']}>

  <section class="contact">
    <div class="contact__inner">
      <div class="contact__intro reveal">
        <p class="label">contact us</p>
        <h1 class="page-title">Get in touch</h1>
        <p class="contact__lead">If you're interested in the product, or want to learn more feel free to contact us for a demo. If you want to know if the product is for you then we will start by doing a detailed calculation of which hardware solution fits with your energy setup at home.</p>
      </div>

      <div class="contact__row">
        <!-- Sends to the same Formspark form as the live site; contact.js submits it without leaving the page -->
        <form class="contact-form reveal" action="https://submit-form.com/NG4zIZy6" method="POST" novalidate>
          <div class="contact-form__row">
            <input class="contact-form__field" type="text" name="name" placeholder="Name" aria-label="Name" autocomplete="name">
            <input class="contact-form__field" type="email" name="email" placeholder="Email" aria-label="Email" autocomplete="email">
          </div>
          <textarea class="contact-form__field contact-form__message" name="message" placeholder="Message" aria-label="Message"></textarea>
          <button class="contact-form__submit" type="submit">Send Message</button>
        </form>

        <aside class="contact__aside reveal">
          <div class="feature-card contact__card">
            <div class="feature-card__icon"><svg><use href="#icon-map-pin" /></svg></div>
            <div class="feature-card__text">
              <h2 class="feature-card__title">Almere</h2>
              <p class="body-text">Transistorstraat 151<br>1322 CN Almere<br>The Netherlands</p>
            </div>
          </div>
          <div class="contact__connect">
            <p class="label">CONNECT WITH US</p>
            <a class="contact__linkedin" href="https://www.linkedin.com/company/hermanos-energy/" target="_blank" rel="noopener" aria-label="Hermanos Energy on LinkedIn">
              <svg aria-hidden="true"><use href="#icon-linkedin" /></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/contact.js';
</script>
