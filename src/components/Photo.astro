---
// Optimised photo: renders a <picture> with AVIF and WebP sources plus the original format as fallback, in several
// widths. `src` is a path inside src/assets/images, e.g. "aboutus/founders.jpg".
// <picture> uses display: contents (base.css), so existing CSS that targets the <img> keeps working unchanged.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  eager?: boolean; // above the fold: load right away instead of lazily
  class?: string;
}

const { src, alt, sizes, eager = false, class: className } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png}', { eager: true });
const image = images[`../assets/images/${src}`]?.default;
if (!image) throw new Error(`Photo not found in src/assets/images: ${src}`);

// Widths to generate, never larger than the original
const widths = [480, 800, 1200, 1600, 2048].filter((w) => w < image.width).concat(image.width);
---

<Picture
  src={image}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class={className}
/>
