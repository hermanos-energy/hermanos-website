---
// Product detail template (Power to Heat / Drive / Power): dark hero with diagram, key features,
// tabbed section that swaps text + image, and an "in action" section.
// Structure comes from src/data/productDetails.ts, text from src/i18n/<lang>.json (productDetails.<key>).
import Features from './Features.astro';
import Photo from './Photo.astro';
import { localUrl, useTranslations, type Lang } from '../i18n';
import { productNames } from '../data/products';
import type { ProductDetailConfig } from '../data/productDetails';
import '../styles/product-detail.css';

interface Props {
  lang: Lang;
  config: ProductDetailConfig;
}

const { lang, config } = Astro.props;
const t = useTranslations(lang);
const text = t.productDetails[config.key];
const name = productNames[config.key];
const img = (file: string) => `${config.slug}/${file}`;
const tabVars = Object.entries(config.tabs.layout).map(([key, value]) => `--${key}: ${value}`).join('; ');

type Items<T> = Record<string, T>;
const featureText = text.features.items as Items<{ title: string; text: string }>;
const tabText = text.tabs.items as Items<{ label: string; text: string; alt: string }>;
const features = config.features.map((f) => ({ icon: f.icon, size: f.size, ...featureText[f.id] }));
---

<!-- ── Hero ── -->
<section class="detail-hero">
  <div class="detail-hero__text reveal">
    <p class="label">{t.productDetails.label}</p>
    <h1 class="page-title">{name}</h1>
    <p class="page-subtitle">{text.subtitle}</p>
  </div>
  <div class="detail-hero__diagram reveal">
    <Photo src={img('diagram.jpg')} alt={text.diagramAlt} sizes="(min-width: 1200px) 1200px, 100vw" eager />
  </div>
</section>

<Features label={t.common.keyFeatures} heading={text.features.heading} items={features} />

<!-- ── Tabs (seasons / day-night) ── -->
<section class="seasons">
  <div class="seasons__inner">
    <h2 class="heading">{text.tabs.heading}</h2>
    <p class="body-text">{text.tabs.intro}</p>

    <div class="tabs" style={tabVars}>
      <div class="tabs__buttons" role="tablist">
        {config.tabs.items.map((tab, i) => (
          <button class="tabs__button" type="button" role="tab" aria-selected={String(i === 0)} aria-controls={`tab-${tab.id}`}>{tabText[tab.id].label}</button>
        ))}
      </div>

      {config.tabs.items.map((tab, i) => (
        <div class="tab-panel" id={`tab-${tab.id}`} role="tabpanel" hidden={i > 0}>
          <p class:list={['body-text', 'tab-panel__text', tab.fixedText && 'tab-panel__text--fixed', i === 0 && 'reveal']} set:html={tabText[tab.id].text} />
          <div class:list={['tab-panel__image', 'card-border', i === 0 && 'reveal']}>
            <Photo src={img(`${tab.id}.jpg`)} alt={tabText[tab.id].alt} sizes="(min-width: 1200px) 1000px, 100vw" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── In action ── -->
<section class:list={['in-action', config.wideInActionOnMobile && 'in-action--wide-mobile']}>
  <div class="in-action__inner reveal">
    <div class="in-action__photo">
      <Photo src={img('in-action.jpg')} alt={text.inActionPhotoAlt} sizes="(min-width: 1200px) 640px, 100vw" />
    </div>
    <div class="in-action__text">
      <h2 class="title">{name} {t.productDetails.inActionSuffix}</h2>
      <p class="body-text">{t.productDetails.inActionText}</p>
      <a class="text-link" href={localUrl(lang, 'contact')}>{t.productDetails.getADemo} <svg aria-hidden="true"><use href="#icon-arrow-right" /></svg></a>
    </div>
  </div>
</section>
